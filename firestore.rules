rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function name() { return get(/databases/$(database)/documents/users_map/$(request.auth.uid)).data.username; }

    match /profiles/{u} {
      allow read: if signed();
      allow create: if signed() && request.resource.data.uid == request.auth.uid;
      allow update: if signed() && resource.data.uid == request.auth.uid;
    }
    match /users_map/{id} { allow read, write: if signed() && request.auth.uid == id; }
    match /users/{u}/friends/{f} { allow read, write: if signed(); }
    match /chats/{room}/messages/{m} {
      allow read, create: if signed();
      allow delete: if signed() && resource.data.sender == name();
    }
    match /servers/{s} {
      allow read, create: if signed();
      allow update: if signed() && (resource.data.owner == name() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']));
      allow delete: if signed() && resource.data.owner == name();
      match /messages/{m} {
        allow read, create: if signed();
        allow delete: if signed() && (resource.data.sender == name() ||
          get(/databases/$(database)/documents/servers/$(s)).data.owner == name());
      }
    }
  }
}
